# Run the extensionless metadata file as PHP (proven pattern from the bridge's
# own .well-known folder). Also stop WordPress from rewriting this path away.
<Files "php-mcp-bridge">
    SetHandler application/x-httpd-php
    Require all granted
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # This directory holds real files — never hand off to a front controller.
    RewriteRule ^ - [L]
</IfModule>
