# Pass the Authorization header through to PHP. Many shared hosts (LiteSpeed,
# Apache CGI/FastCGI) strip it, which breaks OAuth Bearer auth. Belt and braces:
# CGIPassAuth for Apache 2.4.13+, and a rewrite that mirrors it into an env var.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_cgi.c>
    CGIPassAuth On
</IfModule>
<IfModule mod_fcgid.c>
    CGIPassAuth On
</IfModule>
<IfModule lsapi_module>
    CGIPassAuth On
</IfModule>

# Block direct HTTP access to files that are only ever require()'d by other
# scripts, never requested directly. None of these currently echo anything
# sensitive if hit directly, but there's no reason to leave that door open
# for a future change to accidentally walk through.
<FilesMatch "^(db|mcp-router|config|config\.example)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>
