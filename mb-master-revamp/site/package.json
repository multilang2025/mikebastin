{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "lint:copy": "node scripts/copy-lint.mjs",
    "lint:code": "node scripts/copy-lint-code.mjs",
    "check:launch": "node scripts/launch-check.mjs",
    "verify": "npm run typecheck && npm run lint:copy && npm run lint:code && node scripts/post-structure-lint.mjs --errors && npm run build && npm run lint:jargon && npm run lint:headings && npm run lint:keywords && npm run lint:redirects && npm run audit:sources && npm run check:launch",
    "lint:jargon": "node scripts/copy-jargon-lint.mjs",
    "lint:structure": "node scripts/post-structure-lint.mjs",
    "report:jargon": "node scripts/copy-jargon-lint.mjs --report",
    "audit:sources": "node scripts/copy-sources-audit.mjs",
    "lint:headings": "node scripts/heading-shape-lint.mjs",
    "lint:keywords": "node --experimental-strip-types scripts/keyword-coverage-lint.mjs",
    "lint:redirects": "node scripts/redirect-coverage-lint.mjs",
    "images:blog": "node --experimental-strip-types scripts/fetch-legacy-images.mjs && node --experimental-strip-types scripts/fetch-commons-images.mjs && node --experimental-strip-types scripts/optimize-blog-images.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "marked": "^18.0.11",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wawoff2": "^2.0.1"
  }
}
