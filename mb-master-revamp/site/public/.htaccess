# Static preview build. Apache / LiteSpeed.

# Next exports its own 404 page.
ErrorDocument 404 /404.html

# Hashed build assets never change: cache them hard.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(woff2|js|css)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>
</IfModule>

# Belt and braces on top of robots.txt and the noindex meta tag.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# BEGIN valencia-exodus (generated by site/scripts/gen-redirects.mjs)
# Do not hand-edit this block. Edit redirects/valencia-exodus.json and
# regenerate with `node scripts/gen-redirects.mjs`.
# 20 of 27 URLs have a target; 7 are waiting on a page
# to exist on valenciamove.com.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^international-schools-in-valencia/?$ https://valenciamove.com/international-schools-valencia/ [R=301,L]
# 10,601 impressions, the highest-value URL in the exodus. VM already ranks its own page for this. Republishing would put the two in direct competition.
RewriteRule ^valencia-cost-of-living/?$ https://valenciamove.com/cost-of-living-valencia/ [R=301,L]
# HANDOFF.md §18 says merge INTO cost-of-living during the move: one fact-check, one VM page.
RewriteRule ^valencia-living-expenses/?$ https://valenciamove.com/cost-of-living-valencia/ [R=301,L]
RewriteRule ^move-to-valencia-spain-from-usa/?$ https://valenciamove.com/moving-to-valencia-from-usa/ [R=301,L]
# Second US-origin post. Same destination page as the one above; check the two do not each carry unique material before collapsing them.
RewriteRule ^american-move-to-valencia-spain/?$ https://valenciamove.com/moving-to-valencia-from-usa/ [R=301,L]
RewriteRule ^shipping-to-valencia-spain/?$ https://valenciamove.com/shipping-belongings-spain/ [R=301,L]
RewriteRule ^basic-spanish-valencia/?$ https://valenciamove.com/blog/learning-spanish-valencia/ [R=301,L]
RewriteRule ^best-neighborhoods-valencia/?$ https://valenciamove.com/neighborhoods-valencia/ [R=301,L]
# VM's page covers families and professionals together; the mikebastin one is professionals only.
RewriteRule ^neighbourhoods-for-professionals-in-valencia/?$ https://valenciamove.com/blog/best-neighborhoods-families-professionals/ [R=301,L]
RewriteRule ^essential-things-to-do-in-cultural-valencia/?$ https://valenciamove.com/things-to-do-valencia/ [R=301,L]
RewriteRule ^valencia-public-transportation/?$ https://valenciamove.com/valencia-transportation-guide/ [R=301,L]
# No airport page on VM. The transport guide is the nearest home, but an airport guide may deserve its own URL there.
RewriteRule ^valencia-airport-guide/?$ https://valenciamove.com/valencia-transportation-guide/ [R=301,L]
RewriteRule ^valencia-expat/?$ https://valenciamove.com/expat-community-valencia/ [R=301,L]
RewriteRule ^valencia-digital-nomads/?$ https://valenciamove.com/blog/best-areas-valencia-digital-nomads/ [R=301,L]
# Content merged into valenciamove's rewritten noise article rather than ported verbatim (ValenciaMove PR #614). The mikebastin version's sarcasm was dropped by design; the redirect target is the honest-assessment rewrite, not a clone of the source.
RewriteRule ^valencia-50-shades-of-noise/?$ https://valenciamove.com/blog/sounds-of-valencia/ [R=301,L]
# Residue ported into the existing culture-shocks page rather than as a standalone article (ValenciaMove PR #627): making Valencian friends is slow, winter is cold indoors, balcony dogs, plus a Latin America origin group. /valencia-culture-shocks/ already covered twelve of this post's other subjects, so a second page would have competed with it.
RewriteRule ^valencia-the-not-so-perfect-mediterranean-paradise/?$ https://valenciamove.com/valencia-culture-shocks/ [R=301,L]
# 555 impressions on the FR transport sibling aside, this is the FR half of the crown jewel. Same slug either side.
RewriteRule ^fr/cout-de-la-vie-valencia/?$ https://valenciamove.com/fr/cout-de-la-vie-valencia/ [R=301,L]
RewriteRule ^fr/expatrie-valencia/?$ https://valenciamove.com/fr/communaute-expatries-valencia/ [R=301,L]
# 555 impressions.
RewriteRule ^fr/transport-a-valencia/?$ https://valenciamove.com/fr/guide-transports-valencia/ [R=301,L]
# FR sibling of the above. Same VM article, FR slug per slug-translations.ts.
RewriteRule ^fr/valencia-50-nuances-de-bruits/?$ https://valenciamove.com/fr/bruits-de-valencia/ [R=301,L]
</IfModule>
# END valencia-exodus

# BEGIN blog-prune-audit (generated by site/scripts/gen-prune-redirects.mjs)
# Do not hand-edit this block. Targets live in this script's own TARGETS
# map (not content-map.json, which only names a slug for MERGE); update
# there and regenerate with `node scripts/gen-prune-redirects.mjs`.
# 10 posts retired from the blog prune audit: 8 REMOVE, 2 MERGE.
<IfModule mod_rewrite.c>
RewriteEngine On
# Pricing overlap spans several consolidated services, not one; the services index is the honest hub.
RewriteRule ^affordable-seo-services/?$ services/ [R=301,L]
# Owner correction 6 Sep: this is off-site SEO, not technical-seo. Same cluster as optimise-a-google-business-profile, which is retiring to the same page in this batch -- pointed directly here rather than chaining through a post that is about to disappear.
RewriteRule ^boosting-local-seo/?$ services/local-seo/ [R=301,L]
# Topic is already the multilingual-content service's job.
RewriteRule ^cultural-differences-in-multilingual-websites/?$ services/multilingual-content/ [R=301,L]
# Owner confirmed 6 Sep: no experience in that space, nothing on the site to point it at.
RewriteRule ^how-to-make-money-on-youtube/?$ blog/ [R=301,L]
# Vague premise, not tied to AI or marketing despite the slug; no page it naturally belongs under.
RewriteRule ^language-data-analysis/?$ blog/ [R=301,L]
# Vendor-comparison/competitor-promotion content with no owning service; the services index is the honest hub rather than a false single match.
RewriteRule ^language-service-providers/?$ services/ [R=301,L]
# multilingual-keyword-research already owns this topic, with 2,852 impressions, and stays live at its Journal URL now that /blog/ is wired up.
RewriteRule ^long-tail-keywords/?$ blog/multilingual-keyword-research/ [R=301,L]
# Owner correction 6 Sep: this is off-site/local visibility work, not technical-seo. local-seo has its own page now.
RewriteRule ^optimise-a-google-business-profile/?$ services/local-seo/ [R=301,L]
# The website-localisation service page already makes this case, with an offer behind it.
RewriteRule ^roi-of-website-localisation/?$ services/website-localisation/ [R=301,L]
# Generic listicle, no unique angle, no page it naturally belongs under.
RewriteRule ^seo-mistakes-to-avoid/?$ blog/ [R=301,L]
</IfModule>
# END blog-prune-audit

